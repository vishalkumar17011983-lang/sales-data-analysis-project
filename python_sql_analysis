# ---------------- INSIGHTS ----------------

def show_insights(m, p, c):

    print("\n📊 ===== BUSINESS INSIGHTS =====\n")

    highest_month = max(m, key=lambda x: x[1])
    lowest_month = min(m, key=lambda x: x[1])

    print("📈 Monthly Performance")
    print("Highest Sales Month :", highest_month[0], "→ ₹", highest_month[1])
    print("Lowest Sales Month  :", lowest_month[0], "→ ₹", lowest_month[1])

    top_product = max(p, key=lambda x: x[1])

