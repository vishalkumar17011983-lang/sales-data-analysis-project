# ---------------- CHARTS ----------------

def monthly_sales_chart(m):

    months = []
    sales = []

    for row in m:
        months.append(row[0])
        sales.append(row[1])

    plt.figure(figsize=(8,5))

    plt.plot(months, sales, marker='o')

    plt.title("Monthly Sales Trend")
    plt.xlabel("Month")
    plt.ylabel("Sales")

    plt.grid(True)

    plt.show()


def product_sales_chart(p):

    products = []
    sales = []

    for row in p:
        products.append(row[0])
        sales.append(row[1])

    plt.figure(figsize=(8,5))

    plt.bar(products, sales)

    plt.title("Product Sales")
    plt.xlabel("Products")
    plt.ylabel("Sales")

    plt.xticks(rotation=15)

    plt.show()


def city_sales_chart(c):

    cities = []
    sales = []

    for row in c:
        cities.append(row[0])
        sales.append(row[1])

    plt.figure(figsize=(7,7))

    plt.pie(sales, labels=cities, autopct='%1.1f%%')

    plt.title("City-wise Sales Contribution")

    plt.show()


def customer_chart(t):

    names = []
    spending = []

    for row in t:
        names.append(row[0])
        spending.append(row[1])

    plt.figure(figsize=(8,5))

    plt.bar(names, spending)

    plt.title("Top Customers")
    plt.xlabel("Customers")
    plt.ylabel("Amount Spent")

    plt.xticks(rotation=10)

    plt.show()


