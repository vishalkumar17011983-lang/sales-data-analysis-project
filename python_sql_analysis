# ---------------- ANALYSIS ----------------

def monthly_sales():

    cursor.execute("""
    SELECT DATE_FORMAT(order_date, '%Y-%m') AS month,
           SUM(quantity * price) AS total_sales
    FROM orders
    JOIN products USING(product_id)
    GROUP BY month
    ORDER BY month
    """)

    data = cursor.fetchall()

    print("📊 MONTHLY SALES\n")

    for row in data:
        print("Month:", row[0], "| Sales:", row[1])

    return data


def product_sales():

    cursor.execute("""
    SELECT product_name,
           SUM(quantity * price) AS total_sales
    FROM orders
    JOIN products USING(product_id)
    GROUP BY product_name
    ORDER BY total_sales DESC
    """)

    data = cursor.fetchall()

    print("\n📦 PRODUCT SALES\n")

    for row in data:
        print(row[0], ":", row[1])

    return data


def city_sales():

    cursor.execute("""
    SELECT city,
           SUM(quantity * price) AS total_sales
    FROM orders
    JOIN customers USING(customer_id)
    JOIN products USING(product_id)
    GROUP BY city
    ORDER BY total_sales DESC
    """)

    data = cursor.fetchall()

    print("\n🌍 CITY SALES\n")

    for row in data:
        print(row[0], ":", row[1])

    return data


def top_customers():

    cursor.execute("""
    SELECT c.name,
           SUM(o.quantity * p.price) AS total_spent
    FROM orders o
    JOIN customers c USING(customer_id)
    JOIN products p USING(product_id)
    GROUP BY c.name
    ORDER BY total_spent DESC
    LIMIT 5
    """)

    data = cursor.fetchall()

    print("\n🧑 TOP CUSTOMERS\n")

    for row in data:
        print(row[0], "→ ₹", row[1])

    return data


